# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Pi Network Testnet Platform API Key (server-side secret; never log or expose)
PI_API_KEY=""

# Pi Network Sandbox Client Reference (Testnet only)
VITE_PI_API_KEY=""
VITE_PI_SANDBOX="true"

# Demo Data Flag (set to "false" for empty production state)
VITE_DEMO_MODE="true"
