# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Pi Network Testnet Platform API Key (BACKEND ONLY - set as PI_API_KEY in Vercel, NO VITE_ prefix)
# Used exclusively by /api/pi/approve and /api/pi/complete.
# If omitted, AFOMI safely runs in Pi Testnet Sandbox demo mode.
PI_API_KEY=""
